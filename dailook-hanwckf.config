#
# Netcore N60 Pro 512ROM —— ImmortalWrt 25.12 (mediatek/filogic) 构建配置
# 硬改硬件：2 GiB 内存 / 512 MiB SPI-NAND
# 机型 netcore_n60pro-512rom 由 diy-part3.sh 在 make defconfig 之前注入，
# 因此这里可以直接引用 CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60pro-512rom。
# 其余未列出的选项全部取 25.12 默认值（make defconfig 自动补齐）。
#

# 目标与机型：只选 512rom
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60pro-512rom=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_netcore_n60pro-512rom=""

# 标准 LuCI 路由：LuCI 界面（含中文）、firewall4（nftables）、dnsmasq-full
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq-full=y

# PassWall2：sing-box 核心 + nftables 透明代理
# 核心选择符号取自 Openwrt-Passwall/openwrt-passwall2 仓库
# luci-app-passwall2/Makefile 中的 config 定义（Basic_Core_SingBox）。
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y

# mosdns 与 LuCI 前端（sbwml/luci-app-mosdns，v5 默认分支，支持 25.12/apks）
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y
